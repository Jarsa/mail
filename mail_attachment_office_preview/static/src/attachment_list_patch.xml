<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Office files count as PDF for the viewers, but they have no PDF
         thumbnail: keep the regular hover (name and size) on their card. -->
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Attachment-hover')]" position="attributes">
            <attribute
                name="t-att-class"
            >{ 'o-bgTranslucent': attachment.isImage or attachment.isVideo or (attachment.isPdf and !attachment.isOffice), 'pe-5': group.duplicates.length > 1 }</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('o-mail-Attachment-hover')]/t[@t-if='!attachment.isPdf']"
            position="attributes"
        >
            <attribute name="t-if">!attachment.isPdf or attachment.isOffice</attribute>
        </xpath>
    </t>
</templates>
